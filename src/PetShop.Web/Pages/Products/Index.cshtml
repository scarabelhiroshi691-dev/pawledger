@page
@model PetShop.Web.Pages.Products.IndexModel
@{ViewData["Title"]="商品库存";}
<div class="content-header"><div><h1>商品库存</h1><p>商品销售会自动扣减库存并形成支付记录。</p></div><a class="button button-primary" asp-page="Sale">商品收银</a></div>@if(TempData["Success"] is string ok){<div class="notice success">@ok</div>}@if(TempData["Error"] is string err){<div class="notice error">@err</div>}
<section class="content-panel"><h2>新建商品</h2><form method="post" asp-page-handler="Create" class="inline-form"><input asp-for="Input.Name" placeholder="商品名"/><input asp-for="Input.Sku" placeholder="SKU"/><input asp-for="Input.Price" placeholder="售价" inputmode="decimal"/><input asp-for="Input.Stock" placeholder="期初库存" inputmode="decimal"/><input asp-for="Input.LowStock" placeholder="预警数" inputmode="decimal"/><button class="button button-primary">保存</button></form><div asp-validation-summary="All" class="validation-summary"></div></section>
<section class="content-panel"><div class="table-wrap"><table><thead><tr><th>商品</th><th>售价</th><th>当前库存</th><th>库存调整</th></tr></thead><tbody>@foreach(var x in Model.Products){<tr class="@(x.StockQuantity<=x.LowStockThreshold?"row-warning":"")"><td>@x.Name<small>@x.Sku</small></td><td>¥@x.SalePrice.ToString("F2")</td><td>@x.StockQuantity.ToString("0.##") @(x.StockQuantity<=x.LowStockThreshold?"· 低库存":"")</td><td><form method="post" asp-page-handler="Adjust" class="inline-form compact"><input type="hidden" name="id" value="@x.Id"/><input name="change" type="number" step="0.01" placeholder="+入库 / -盘亏"/><input name="note" placeholder="原因"/><button class="button button-muted">调整</button></form></td></tr>}</tbody></table></div>@if(Model.Products.Count==0){<div class="empty-state">还没有商品，可先建立商品档案。</div>}</section><partial name="_ValidationScriptsPartial"/>
