@page
@model PetShop.Web.Pages.Products.SaleModel
@{ViewData["Title"]="商品收银";}
<div class="content-header"><div><h1>商品收银</h1><p>首版支持每单一种商品；可连续收银形成多笔订单。</p></div></div><section class="content-panel"><form method="post"><input type="hidden" asp-for="Input.RequestId"/><div asp-validation-summary="All" class="validation-summary"></div><div class="form-grid"><label class="field span-2">商品<select asp-for="Input.ProductId" asp-items="Model.ProductOptions"><option value="">请选择</option></select></label><label class="field">数量<input asp-for="Input.Quantity" inputmode="decimal"/></label><label class="field">会员（可选）<select asp-for="Input.MemberCardId" asp-items="Model.MemberOptions"><option value="">散客 / 不扣会员卡</option></select></label><label class="field">余额不足时收款方式<select asp-for="Input.Method" asp-items="Model.Methods"></select></label></div><div class="form-actions"><a class="button button-muted" asp-page="Index">取消</a><button class="button button-primary">确认收银</button></div></form></section><partial name="_ValidationScriptsPartial"/>
