@page
@model PetShop.Web.Pages.Reports.TransactionsModel
@{ViewData["Title"]="订单退款";}
<div class="content-header"><div><h1>订单退款</h1><p>退款不修改历史支付，而是新增反向流水，完整保留审计链。</p></div></div>@if(TempData["Success"] is string ok){<div class="notice success">@ok</div>}@if(TempData["Error"] is string err){<div class="notice error">@err</div>}
<section class="content-panel"><div class="table-wrap"><table><thead><tr><th>时间/类型</th><th>会员</th><th>原支付</th><th>已退</th><th>退款操作</th></tr></thead><tbody>@foreach(var x in Model.Payments){var refunded=x.PrincipalRefunded+x.BonusRefunded+x.ExternalRefunded;var left=x.TotalAmount-refunded;<tr><td>@x.CreatedAt.ToString("MM-dd HH:mm")<small>@PetShop.Web.Pages.Reports.TransactionsModel.Doc(x.DocumentType)</small></td><td>@(x.MemberCard?.Customer.Name??"散客")</td><td>¥@x.TotalAmount.ToString("F2")<small>本 @x.PrincipalPaid.ToString("F2") / 赠 @x.BonusPaid.ToString("F2") / 外 @x.ExternalPaid.ToString("F2")</small></td><td>¥@refunded.ToString("F2")</td><td>@if(left>0){<form method="post" asp-page-handler="Refund" class="inline-form compact"><input type="hidden" name="paymentId" value="@x.Id"/><input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")"/><input name="amount" type="number" step="0.01" max="@left" placeholder="最多 @left.ToString("F2")" required/><input name="reason" placeholder="退款原因" required/><button class="button button-danger">退款</button></form>}else{<span>已全退</span>}</td></tr>}</tbody></table></div>@if(Model.Payments.Count==0){<div class="empty-state">暂无可退款的支付记录。</div>}</section>
