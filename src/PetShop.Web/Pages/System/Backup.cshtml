@page
@model PetShop.Web.Pages.System.BackupModel
@{ViewData["Title"]="备份与恢复";}
<div class="content-header"><div><h1>备份与恢复</h1><p>备份采用 SQLite 在线快照，生成后自动执行完整性检查。</p></div><form method="post"><button class="button button-primary">立即备份</button></form></div>@if(TempData["Success"] is string ok){<div class="notice success">@ok</div>}@if(TempData["Error"] is string err){<div class="notice error">@err</div>}
<section class="content-panel"><h2>数据位置</h2><p class="path-box">@Model.DataDirectory</p><p class="form-hint">恢复属于高风险操作。首版采用随包工具在软件关闭后恢复，避免运行中替换数据库。</p></section>
<section class="content-panel"><h2>可用备份</h2><div class="table-wrap"><table><thead><tr><th>文件</th><th>生成时间</th><th>大小</th></tr></thead><tbody>@foreach(var x in Model.Files){<tr><td>@x.Name</td><td>@x.CreationTime.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@((x.Length/1024d).ToString("N0")) KB</td></tr>}</tbody></table></div>@if(Model.Files.Count==0){<div class="empty-state">尚未创建备份。建议每日闭店后备份，并定期复制到 U 盘。</div>}</section>
