@page
@model PetShop.Web.Pages.Grooming.CreateModel
@{ViewData["Title"]="美容预约";}
<div class="content-header"><div><h1>新建美容预约</h1><p>没有可选项时，请先录入会员宠物、员工和服务项目。</p></div></div><section class="content-panel"><form method="post"><div asp-validation-summary="All" class="validation-summary"></div><div class="form-grid"><label class="field">宠物<select asp-for="Input.PetId" asp-items="Model.Pets"><option value="">请选择</option></select></label><label class="field">服务项目<select asp-for="Input.ServiceId" asp-items="Model.Services"><option value="">请选择</option></select></label><label class="field">预约时间<input asp-for="Input.ScheduledAt" type="datetime-local"/></label><label class="field">成交价<input asp-for="Input.Price" inputmode="decimal"/></label><label class="field span-2">备注<textarea asp-for="Input.Notes"></textarea></label></div><div class="form-actions"><a class="button button-muted" asp-page="Index">取消</a><button class="button button-primary">保存预约</button></div></form></section><partial name="_ValidationScriptsPartial"/>
