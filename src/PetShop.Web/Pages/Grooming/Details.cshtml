@page "{id:guid}"
@model PetShop.Web.Pages.Grooming.DetailsModel
@{ViewData["Title"]="美容工单";}
<div class="content-header"><div><h1>@Model.Order.OrderNumber</h1><p>@Model.Order.Customer.Name · @Model.Order.Pet.Name · @Model.Order.ServiceItem.Name</p></div><a class="button button-muted" asp-page="Index">返回列表</a></div>@if(TempData["Success"] is string ok){<div class="notice success">@ok</div>}
<div class="two-column"><section class="content-panel"><h2>工单信息</h2><dl class="detail-list"><dt>预约时间</dt><dd>@Model.Order.ScheduledAt.ToString("yyyy-MM-dd HH:mm")</dd><dt>应收金额</dt><dd>¥@Model.Order.AmountDue.ToString("F2")</dd><dt>会员余额</dt><dd>本金 ¥@(Model.Order.Customer.MemberCard?.PrincipalBalance.ToString("F2")??"0.00") + 赠送 ¥@(Model.Order.Customer.MemberCard?.BonusBalance.ToString("F2")??"0.00")</dd><dt>备注</dt><dd>@(string.IsNullOrWhiteSpace(Model.Order.Notes)?"无":Model.Order.Notes)</dd></dl></section>
<section class="content-panel"><h2>@(Model.Order.Status==GroomingStatus.Completed?"已完成":"完工结算")</h2>@if(Model.Order.Status==GroomingStatus.Completed){<div class="notice success">实际美容师：@Model.Order.ActualGroomer?.Name</div>}else{<form method="post" asp-page-handler="Checkout"><input type="hidden" asp-for="RequestId"/><div asp-validation-summary="All" class="validation-summary"></div><label class="field">实际美容师<select asp-for="GroomerId" asp-items="Model.Groomers"><option value="">请选择</option></select></label><label class="field">余额不足时收款方式<select asp-for="Method" asp-items="Model.Methods"></select></label><p class="form-hint">扣款顺序：赠送金 → 本金 → 外部收款。</p><div class="form-actions"><button class="button button-primary">确认完成并结算</button></div></form>}</section></div>
